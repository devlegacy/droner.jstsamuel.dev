{
  "name": "droner",
  "version": "0.0.1",
  "description": "Droner project - using powerful of sass",
  "scripts": {
    "server": "http-server ./public -a localhost -p 8080 -e -g -c-1",
    "sass": "sass ./src/assets/sass:./public/assets/css --load-path=node_modules",
    "sass:watch": "npm run sass -- --watch --verbose",
    "sass:compile": "npm run sass -- --no-source-map ",
    "postcss:prefixer": "npx postcss ./public/assets/css/app.css --use autoprefixer -o ./public/assets/css/app.css",
    "postcss:nano": "npx postcss ./public/assets/css/app.css --use cssnano -o ./public/assets/css/app.css --no-map",
    "prefixer:watch": "npm run postcss:prefixer -- -w",
    "prefixer:compile": "npm run postcss:prefixer -- --no-map",
    "dev": "npm-run-all --parallel sass:watch server",
    "prod": "npm-run-all sass:compile prefixer:compile postcss:nano"
  },
  "keywords": [],
  "author": "Samuel R. <contact@jstsamuel.dev> (https://jstsamuel.dev)",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "10.5.4",
    "http-server": "14.1.1",
    "npm-run-all2": "8.0.4",
    "postcss": "8.5.26",
    "postcss-cli": "11.0.1",
    "sass": "1.103.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "7.3.1",
    "cssnano": "9.0.1",
    "flexboxgrid": "6.3.1",
    "normalize.css": "8.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlegacy/droner.jstsamuel.dev.git"
  },
  "bugs": {
    "url": "https://github.com/devlegacy/droner.jstsamuel.dev/issues"
  },
  "homepage": "https://droner.jstsamuel.dev",
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
