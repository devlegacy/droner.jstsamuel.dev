{
  "name": "droner",
  "version": "0.0.1",
  "description": "Droner project - using powerful of sass",
  "main": "index.js",
  "scripts": {
    "server": "http-server ./public -a localhost -p 8080 -e -g -o -c-1",
    "sass": "sass ./src/assets/sass:./public/assets/css",
    "sass:watch": "npm run sass -- --watch",
    "sass:compile": "npm run sass -- --no-source-map ",
    "prefixer": "npx postcss ./public/assets/css/app.css --use autoprefixer -o ./public/assets/css/app.css",
    "nano": "npx postcss ./public/assets/css/app.css --use cssnano -o ./public/assets/css/app.css --no-map",
    "prefixer:watch": "npm run prefixer -- -w",
    "prefixer:compile": "npm run prefixer -- --no-map",
    "dev": "npm-run-all --parallel sass:watch server",
    "prod": "npm-run-all sass:compile prefixer:compile nano"
  },
  "keywords": [],
  "author": "Samuel R. <samuel@devexteam.com> (https://devexteam.com)",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.0.4",
    "http-server": "^0.12.3",
    "npm-run-all": "^4.1.5",
    "postcss-cli": "^8.3.0",
    "sass": "^1.30.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.15.1",
    "cssnano": "^4.1.10",
    "flexboxgrid": "^6.3.1",
    "normalize.css": "^8.0.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlegacy/droner.git"
  },
  "bugs": {
    "url": "https://github.com/devlegacy/droner/issues"
  },
  "homepage": "https://github.com/devlegacy/droner#readme"
}
