{
  "name": "droner",
  "version": "0.0.1",
  "description": "Droner project - using powerful of sass",
  "main": "index.js",
  "scripts": {
    "server": "http-server ./public -a localhost -p 8080 -e -g -c-1",
    "sass": "sass ./src/assets/sass:./public/assets/css --load-path=node_modules",
    "sass:watch": "npm run sass -- --watch --verbose",
    "sass:compile": "npm run sass -- --no-source-map ",
    "postcss:prefixer": "npx postcss ./public/assets/css/app.css --use autoprefixer -o ./public/assets/css/app.css",
    "postcss:nano": "npx postcss ./public/assets/css/app.css --use cssnano -o ./public/assets/css/app.css --no-map",
    "prefixer:watch": "npm run postcss:prefixer -- -w",
    "prefixer:compile": "npm run postcss:prefixer -- --no-map",
    "dev": "npm-run-all --parallel sass:watch server",
    "prod": "npm-run-all sass:compile prefixer:compile postcss:nano"
  },
  "keywords": [],
  "author": "Samuel R. <samuel@devexteam.com> (https://devexteam.com)",
  "license": "MIT",
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "cssnano": "^7.0.6",
    "flexboxgrid": "^6.3.1",
    "normalize.css": "^8.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devlegacy/droner.git"
  },
  "bugs": {
    "url": "https://github.com/devlegacy/droner/issues"
  },
  "homepage": "https://github.com/devlegacy/droner#readme",
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf"
}
